{
    "services": {
        "web": {
            "root": "apps/web",
            "framework": "nextjs"
        },
        "ai-service": {
            "root": "services/ai-service"
        },
        "api": {
            "root": "services/api"
        }
    },
    "rewrites": [
        {
            "source": "/api/ai-service(/.*)?",
            "destination": {
                "type": "service",
                "service": "ai-service"
            }
        },
        {
            "source": "/api/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "api"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "web"
            }
        }
    ]
}
