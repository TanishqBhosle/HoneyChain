# ===========================================
# Honey Chain — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/honeychain?schema=public"

# --- JWT Auth ---
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# --- OTP (Mock for hackathon — accepts 123456) ---
OTP_MOCK_ENABLED=true

# --- Blockchain (Polygon Amoy Testnet) ---
POLYGON_RPC_URL="https://rpc-amoy.polygon.technology/"
DEPLOYER_PRIVATE_KEY="your-wallet-private-key"
CONTRACT_ADDRESS="deployed-contract-address"
POLYGONSCAN_API_KEY=""

# --- AI Service ---
AI_SERVICE_URL="http://localhost:8000"

# --- MQTT Broker ---
MQTT_BROKER_URL="mqtt://localhost:1883"

# --- File Uploads ---
UPLOAD_DIR="./uploads"

# --- QR Code Signing ---
QR_HMAC_SECRET="your-qr-signing-secret-change-in-production"

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- API Server ---
API_PORT=3001
